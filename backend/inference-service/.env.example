# Machine 1 — 1B model, public ngrok URL from scripts/machine1-serve.sh
MACHINE_1B_URL=https://xxxx.ngrok-free.app
MODEL_1B=llama3.2:1b

# Machine 2 (external) — 3B model, public ngrok URL from serve-models.sh 3B
MACHINE_3B_URL=https://elk-abnormal-applicant.ngrok-free.dev
MODEL_3B=llama3.2:3b

# Machine 3 (external) — Verification Service. Leave empty to skip verification calls.
VERIFIER_URL=http://192.168.1.30:9000

OLLAMA_TIMEOUT=120

# ---- On-chain mode (Monad). Leave CONTRACT_ADDRESS empty to run without the chain.
RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=
# Key allowed to call recordRequest: the deployer wallet (cast wallet decrypt-keystore deployer).
SERVICE_PRIVATE_KEY=
# Wallets the provider machines staked from
PROVIDER_1B_ADDRESS=
PROVIDER_3B_ADDRESS=
